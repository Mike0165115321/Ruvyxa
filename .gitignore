# Project-scope deploy artifacts written by `ruvyxa build --adapter <platform>`
# when the demo app is built for a hosting platform. Scoped to examples/demo so
# a hand-authored netlify.toml or wrangler.jsonc elsewhere is still tracked.
examples/demo/.vercel/
examples/demo/.netlify/
examples/demo/netlify.toml
examples/demo/netlify/functions/
examples/demo/wrangler.jsonc
examples/demo/railway.json
examples/demo/render.yaml
examples/demo/firebase.json
examples/demo/.amplify-hosting/
examples/demo/_headers
examples/demo/_redirects
